{
  "name": "tec-usbc-board",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run node_modules/tscircuit/cli.mjs build index.tsx",
    "build:local": "bun run build",
    "dev": "bun run node_modules/tscircuit/cli.mjs dev index.tsx",
    "check:style": "bun run node_modules/tscircuit/cli.mjs check pcb-style dist/index/circuit.json --json --svg dist/index/pcb-style.svg",
    "check:shorts": "bun run node_modules/tscircuit/cli.mjs check shorts dist/index/circuit.json --mode gerber --layer all",
    "export:jlcpcb": "bun run scripts/export-manufacturing.ts",
    "export:kicad": "bun run scripts/export-kicad.ts",
    "check:routed": "bun run scripts/check-routed-board.ts",
    "check:guarded": "bun run scripts/test-guarded-router.ts",
    "prepare:assembly": "bun run scripts/prepare-assembly.ts",
    "export:previews": "bun run scripts/export-previews.ts",
    "check:physical": "bun run scripts/check-physical.ts",
    "build:regenerate": "bun run scripts/build-with-watchdog.ts",
    "build:regenerate:cli": "bun run node_modules/tscircuit/cli.mjs build regenerate.tsx --svgs --autorouter-debug --autorouter-dump-srj all --autorouter-timeout 6m",
    "check:saved-routes": "bun run scripts/check-saved-routes.tsx && bun run scripts/check-source-evaluator.ts"
  },
  "dependencies": {
    "eventemitter3": "5.0.4",
    "tscircuit": "0.0.2809"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/capacity-autorouter": "0.0.967",
    "@tscircuit/cli": "0.1.2287",
    "@tscircuit/core": "0.0.2124",
    "@types/bun": "1.4.2",
    "@types/clipper-lib": "6.4.0",
    "circuit-json-to-gltf": "0.0.151",
    "circuit-json-to-kicad": "0.0.230",
    "circuit-to-svg": "0.0.445",
    "clipper-lib": "6.4.2",
    "easyeda": "0.0.375",
    "fflate": "0.8.2",
    "polygon-clipping": "0.15.7",
    "poppygl": "0.0.34",
    "typescript": "5.9.3"
  }
}
