{
  "build": {
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32G0 -DSTM32G0xx -DSTM32G030xx",
    "f_cpu": "16000000L",
    "mcu": "stm32g030f6",
    "product_line": "STM32G030xx"
  },
  "debug": {
    "default_tools": ["stlink"],
    "jlink_device": "STM32G030F6",
    "openocd_target": "stm32g0x",
    "svd_path": "STM32G030.svd"
  },
  "frameworks": ["stm32cube"],
  "name": "General USB-C PD driver (STM32G030F6P6)",
  "upload": {
    "maximum_ram_size": 8192,
    "maximum_size": 32768,
    "protocol": "stlink",
    "protocols": ["stlink", "cmsis-dap", "jlink"]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32g030f6.html",
  "vendor": "STMicroelectronics"
}
